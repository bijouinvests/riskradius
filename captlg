    <div id="root"></div>

    <!-- Footer -->
    <footer style="background: linear-gradient(135deg, #045174 0%, #056691 100%); color: #f8dcbf; padding: 40px 0 20px 0; margin-top: 60px;">
        <div style="max-width: 1400px; margin: 0 auto; padding: 0 20px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; margin-bottom: 30px;">
                <div>
                    <h3 style="color: #d4af37; font-size: 20px; margin-bottom: 15px; font-weight: 700;">MyLocalFiduciary</h3>
                    <p style="color: #f8dcbf; opacity: 0.9; line-height: 1.6; margin: 0 0 15px 0; font-size: 14px;">
                        Professional financial advisory services focused on comprehensive wealth management.
                    </p>
                </div>
                <div>
                    <h4 style="color: #d4af37; font-size: 16px; margin-bottom: 15px; font-weight: 600;">CAPTLG Framework</h4>
                    <ul style="list-style: none; padding: 0; margin: 0;">
                        <li style="margin-bottom: 10px; color: #f8dcbf; opacity: 0.9; font-size: 14px;"><strong>C</strong>ashflow</li>
                        <li style="margin-bottom: 10px; color: #f8dcbf; opacity: 0.9; font-size: 14px;"><strong>A</strong>ssets</li>
                        <li style="margin-bottom: 10px; color: #f8dcbf; opacity: 0.9; font-size: 14px;"><strong>P</strong>rotections</li>
                        <li style="margin-bottom: 10px; color: #f8dcbf; opacity: 0.9; font-size: 14px;"><strong>T</strong>axes</li>
                        <li style="margin-bottom: 10px; color: #f8dcbf; opacity: 0.9; font-size: 14px;"><strong>L</strong>iabilities</li>
