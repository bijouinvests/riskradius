            </div>
            <div style="border-top: 1px solid rgba(248, 220, 191, 0.2); padding-top: 20px; text-align: center;">
                <p style="color: #f8dcbf; opacity: 0.7; margin: 0; font-size: 13px;">
                    © 2026 MyLocalFiduciary. All rights reserved.
                </p>
            </div>
        </div>
    </footer>


    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // State tax rates by state (can be expanded)
        const STATE_TAX_RATES = {
            'CA': { // California
                single: [
                    { max: 10099, rate: 0.01 },
                    { max: 23942, rate: 0.02, base: 101, threshold: 10099 },
                    { max: 37788, rate: 0.04, base: 378, threshold: 23942 },
                    { max: 52455, rate: 0.06, base: 932, threshold: 37788 },
                    { max: 66295, rate: 0.08, base: 1812, threshold: 52455 },
                    { max: Infinity, rate: 0.093, base: 2919, threshold: 66295 }
                ],
                couple: [
                    { max: 20198, rate: 0.01 },
                    { max: 47884, rate: 0.02, base: 202, threshold: 20198 },
                    { max: 75576, rate: 0.04, base: 756, threshold: 47884 },
                    { max: 104910, rate: 0.06, base: 1863, threshold: 75576 },
                    { max: 132590, rate: 0.08, base: 3623, threshold: 104910 },
                    { max: Infinity, rate: 0.093, base: 5837, threshold: 132590 }
                ]
            },
            'TX': { single: [], couple: [] }, // No state income tax
            'FL': { single: [], couple: [] }, // No state income tax
            'NY': { // New York (simplified)
                single: [
                    { max: 8500, rate: 0.04 },
                    { max: 11700, rate: 0.045, base: 340, threshold: 8500 },
                    { max: 13900, rate: 0.0525, base: 484, threshold: 11700 },
                    { max: 80650, rate: 0.055, base: 600, threshold: 13900 },
                    { max: 215400, rate: 0.06, base: 4271, threshold: 80650 },
                    { max: 1077550, rate: 0.0685, base: 12356, threshold: 215400 },
                    { max: Infinity, rate: 0.0965, base: 71413, threshold: 1077550 }
                ],
                couple: [
                    { max: 17150, rate: 0.04 },
                    { max: 23600, rate: 0.045, base: 686, threshold: 17150 },
                    { max: 27900, rate: 0.0525, base: 976, threshold: 23600 },
                    { max: 161550, rate: 0.055, base: 1202, threshold: 27900 },
                    { max: 323200, rate: 0.06, base: 8553, threshold: 161550 },
                    { max: 2155350, rate: 0.0685, base: 18252, threshold: 323200 },
                    { max: Infinity, rate: 0.0965, base: 143754, threshold: 2155350 }
                ]
            }
        };

        // Icons
        const Save = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
        );

        const Download = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
        );

        const Upload = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
        );

        const RefreshCw = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
        );

        const Send = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        );

        const Check = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        );

        const DollarSign = ({ size = 24 }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
        );

        const CAPTLGIntakeForm = () => {
            const [clientType, setClientType] = useState('couple');
            const [activeTab, setActiveTab] = useState('income'); // 'income' or 'cashflow'
            const [formData, setFormData] = useState({
                client1Name: '',
                client1Birthday: '',
                client2Name: '',
                client2Birthday: '',
                address: '',
                city: '',
                state: '',
                zipCode: '',
                grossIncome1: '',
                grossIncome2: '',
                medicalInsurance1: '',
                medicalInsurance2: '',
                preTaxRetirement1: '',
                preTaxRetirement2: '',
                postTaxInvestments1: '',
                postTaxInvestments2: '',
                expensesPlanned: '',
                // Assets as arrays
                realEstate: [{ name: '', equity: '' }],
                retirement401k: [{ name: '', balance: '' }],
                afterTaxRetirement: [{ name: '', balance: '' }],
                brokerageAccounts: [{ name: '', balance: '' }],
                collegeSavings: [{ name: '', balance: '' }],
                cashValueLife: [{ name: '', value: '' }],
                bankAccounts: [{ name: '', balance: '' }],
                vehiclesAssets: [{ name: '', value: '' }],
                otherAssets: [{ description: '', value: '' }],
                // Protections as arrays
                medicalInsurance: [{ type: '', coverage: '' }],
                homeInsurance: [{ property: '', coverage: '' }],
                lifeInsurance: [{ insured: '', benefit: '', term: '' }],
                carInsurance: [{ vehicle: '', coverage: '' }],
                disability: [{ type: '', coverage: '' }],
                longTermCare: [{ insured: '', coverage: '' }],
                umbrellaPolicy: [{ provider: '', coverage: '' }],
                // Liabilities
                mortgages: [{ balance: '', rate: '', term: '' }],
                vehicleLoans: [{ balance: '', rate: '', term: '' }],
                studentLoans: [{ balance: '', rate: '', term: '' }],
                creditCards: [{ balance: '', rate: '', term: '' }],
                personalLoans: [{ balance: '', rate: '', term: '' }],
                friendsFamily: [{ balance: '', rate: '', term: '' }],
                businessLoans: [{ balance: '', rate: '', term: '' }],
                loan401k: [{ balance: '', rate: '', term: '' }],
                medicalDebt: [{ balance: '', rate: '', term: '' }],
                otherLiabilities: [{ description: '', balance: '', rate: '', term: '' }],
                // Taxes
                effectiveTaxRate: '',
                oweTaxesRefund: '',
                // Goals
                shortTerm: '',
                midTerm: '',
                longTerm: ''
            });

            const [calculations, setCalculations] = useState({
                totalGross: 0,
                federalTax: 0,
                socialSecurity: 0,
                medicare: 0,
                stateTax: 0,
                standardDeduction: 0,
                itemizedDeduction: 0,
                effectiveTaxRate: 0,
                estimatedNetIncome: 0,
                annualCashflow: 0,
                monthlyCashflow: 0,
                preTaxDeductions: 0,
                postTaxDeductions: 0
            });

            const [saveNotification, setSaveNotification] = useState('');
            const [completionPercentage, setCompletionPercentage] = useState(0);
            const [sectionCompletion, setSectionCompletion] = useState({
                cashflow: { completed: 0, total: 0, percentage: 0 },
                assets: { completed: 0, total: 0, percentage: 0 },
                protections: { completed: 0, total: 0, percentage: 0 },
                taxes: { completed: 0, total: 0, percentage: 0 },
                liabilities: { completed: 0, total: 0, percentage: 0 },
                goals: { completed: 0, total: 0, percentage: 0 }
            });

            // Load saved data on mount
            useEffect(() => {
                const savedData = localStorage.getItem('captlg-form-data');
                if (savedData) {
                    try {
                        const parsed = JSON.parse(savedData);
                        setClientType(parsed.clientType || 'couple');
                        setFormData(parsed.formData || formData);
                    } catch (error) {
                        console.error('Error loading saved data:', error);
                    }
                }
            }, []);

            // Auto-save every 30 seconds
            useEffect(() => {
                const autoSaveInterval = setInterval(() => {
                    saveToLocalStorage(true);
                }, 30000);
                return () => clearInterval(autoSaveInterval);
            }, [clientType, formData]);

            // Calculate everything when relevant fields change
            useEffect(() => {
                performCalculations();
                calculateCompletion();
            }, [
                formData.grossIncome1,
                formData.grossIncome2,
                formData.preTaxRetirement1,
                formData.preTaxRetirement2,
                formData.medicalInsurance1,
                formData.medicalInsurance2,
                formData.postTaxInvestments1,
                formData.postTaxInvestments2,
                formData.expensesPlanned,
                formData.useItemizedDeductions,
                formData.itemizedDeductions,
                formData.state,
                clientType,
                formData
            ]);

            const calculateStateTax = (taxableIncome, state, filingType) => {
                const stateRates = STATE_TAX_RATES[state];
                if (!stateRates || stateRates[filingType].length === 0) return 0;

                const brackets = stateRates[filingType];
                let tax = 0;

                for (const bracket of brackets) {
                    if (taxableIncome <= bracket.max) {
                        if (bracket.base !== undefined) {
                            tax = bracket.base + (taxableIncome - bracket.threshold) * bracket.rate;
                        } else {
                            tax = taxableIncome * bracket.rate;
                        }
                        break;
                    }
                }

                return tax;
            };

            const performCalculations = () => {
                const gross1 = parseFloat(formData.grossIncome1) || 0;
                const gross2 = parseFloat(formData.grossIncome2) || 0;
                const totalGross = gross1 + gross2;
                
                const preTax1 = parseFloat(formData.preTaxRetirement1) || 0;
                const preTax2 = parseFloat(formData.preTaxRetirement2) || 0;
                const medical1 = parseFloat(formData.medicalInsurance1) || 0;
                const medical2 = parseFloat(formData.medicalInsurance2) || 0;
                const postTax1 = parseFloat(formData.postTaxInvestments1) || 0;
                const postTax2 = parseFloat(formData.postTaxInvestments2) || 0;
                const expenses = parseFloat(formData.expensesPlanned) || 0;
                
                // Total pre-tax deductions (reduce FICA and income tax)
                const preTaxDeductions = preTax1 + preTax2 + medical1 + medical2;
                
                // 2026 standard deductions
                const standardDeduction = clientType === 'couple' ? 32200 : 16100;
                
                // Calculate itemized deductions if selected
                let itemizedDeduction = 0;
                if (formData.useItemizedDeductions) {
                    itemizedDeduction = parseFloat(formData.itemizedDeductions) || 0;
                }
                
                // Use the greater of standard or itemized deduction
                const deduction = formData.useItemizedDeductions && itemizedDeduction > standardDeduction 
                    ? itemizedDeduction 
                    : standardDeduction;
                
                // Taxable income for federal tax (gross - pre-tax deductions - standard/itemized deduction)
                const taxableIncome = Math.max(0, totalGross - preTaxDeductions - deduction);
                
                // 2026 Federal tax brackets
                let federalTax = 0;
                if (clientType === 'couple') {
                    if (taxableIncome <= 24800) federalTax = taxableIncome * 0.10;
                    else if (taxableIncome <= 100800) federalTax = 2480 + (taxableIncome - 24800) * 0.12;
                    else if (taxableIncome <= 211400) federalTax = 11600 + (taxableIncome - 100800) * 0.22;
                    else if (taxableIncome <= 403550) federalTax = 35932 + (taxableIncome - 211400) * 0.24;
                    else if (taxableIncome <= 512450) federalTax = 82048 + (taxableIncome - 403550) * 0.32;
                    else if (taxableIncome <= 768700) federalTax = 116896 + (taxableIncome - 512450) * 0.35;
                    else federalTax = 206584 + (taxableIncome - 768700) * 0.37;
                } else {
                    if (taxableIncome <= 12400) federalTax = taxableIncome * 0.10;
                    else if (taxableIncome <= 50400) federalTax = 1240 + (taxableIncome - 12400) * 0.12;
                    else if (taxableIncome <= 105700) federalTax = 5800 + (taxableIncome - 50400) * 0.22;
                    else if (taxableIncome <= 201775) federalTax = 17966 + (taxableIncome - 105700) * 0.24;
                    else if (taxableIncome <= 256225) federalTax = 41024 + (taxableIncome - 201775) * 0.32;
                    else if (taxableIncome <= 640600) federalTax = 58448 + (taxableIncome - 256225) * 0.35;
                    else federalTax = 193079 + (taxableIncome - 640600) * 0.37;
                }
                
                // IMPORTANT: Social Security calculated on GROSS minus pre-tax deductions
                // 2026 Social Security (6.2% up to $176,100 per person on wages AFTER pre-tax deductions)
                const ssWageBase = 176100;
                const adjustedGross1 = Math.max(0, gross1 - preTax1 - medical1);
                const adjustedGross2 = Math.max(0, gross2 - preTax2 - medical2);
                const ss1 = Math.min(adjustedGross1, ssWageBase) * 0.062;
                const ss2 = Math.min(adjustedGross2, ssWageBase) * 0.062;
                const socialSecurity = ss1 + ss2;
                
                // Medicare (1.45% on adjusted gross + 0.9% over threshold)
                const adjustedTotalGross = adjustedGross1 + adjustedGross2;
                const medicareThreshold = clientType === 'couple' ? 250000 : 200000;
                const baseMedicare = adjustedTotalGross * 0.0145;
                const additionalMedicare = Math.max(0, adjustedTotalGross - medicareThreshold) * 0.009;
                const medicare = baseMedicare + additionalMedicare;
                
                // State tax using the sophisticated calculation
                const filingType = clientType === 'couple' ? 'couple' : 'single';
                const stateTax = calculateStateTax(taxableIncome, formData.state, filingType);
                
                // Total taxes
                const totalTax = federalTax + socialSecurity + medicare + stateTax;
                const effectiveTaxRate = totalGross > 0 ? (totalTax / totalGross) * 100 : 0;
                const estimatedNetIncome = totalGross - totalTax;
                
                // CASHFLOW CALCULATION
                // Annual Cashflow = Net Income - Post-Tax Investments - Expenses
                // Medical insurance and pre-tax retirement don't reduce cashflow directly 
                // because they were already deducted from gross before taxes
                const annualCashflow = estimatedNetIncome - postTax1 - postTax2 - expenses;
                const monthlyCashflow = annualCashflow / 12;
                
                setCalculations({
                    totalGross,
                    federalTax,
                    socialSecurity,
                    medicare,
                    stateTax,
                    standardDeduction,
                    itemizedDeduction: formData.useItemizedDeductions ? itemizedDeduction : 0,
                    effectiveTaxRate,
                    estimatedNetIncome,
                    annualCashflow,
                    monthlyCashflow,
                    preTaxDeductions,
                    postTaxDeductions: postTax1 + postTax2
                });

                // Auto-fill effective tax rate in form
                if (effectiveTaxRate > 0 && !formData.effectiveTaxRate) {
                    handleInputChange('effectiveTaxRate', effectiveTaxRate.toFixed(2) + '%');
                }
            };

            const calculateCompletion = () => {
                // Define fields that are actually shown on the form
                const sections = {
                    cashflow: clientType === 'couple' 
                        ? ['grossIncome1', 'grossIncome2', 'medicalInsurance1', 'medicalInsurance2', 
                           'preTaxRetirement1', 'preTaxRetirement2', 'expensesPlanned']
                        : ['grossIncome1', 'medicalInsurance1', 'preTaxRetirement1', 'expensesPlanned'],
                    assets: ['realEstate', 'retirement401k', 'afterTaxRetirement', 'brokerageAccounts', 'collegeSavings', 
                             'cashValueLife', 'bankAccounts', 'vehiclesAssets', 'otherAssets'],
                    protections: ['medicalInsurance', 'homeInsurance', 'lifeInsurance', 'carInsurance', 
                                  'disability', 'longTermCare', 'umbrellaPolicy'],
                    taxes: ['effectiveTaxRate', 'oweTaxesRefund'],
                    liabilities: ['mortgages', 'vehicleLoans', 'studentLoans', 'creditCards', 'personalLoans', 
                                  'friendsFamily', 'businessLoans', 'loan401k', 'medicalDebt', 'otherLiabilities'],
                    goals: ['shortTerm', 'midTerm', 'longTerm']
                };

                const sectionData = {};
                let totalFilled = 0;
                let totalFields = 0;

                Object.keys(sections).forEach(section => {
                    let filledInSection = 0;
                    let fieldsInSection = sections[section].length;

                    sections[section].forEach(field => {
                        if (Array.isArray(formData[field])) {
                            const hasData = formData[field].some(item => 
                                Object.values(item).some(val => val && val !== '')
                            );
                            if (hasData) filledInSection++;
                        } else if (formData[field] && formData[field] !== '') {
                            filledInSection++;
                        }
                    });

                    sectionData[section] = {
                        completed: filledInSection,
                        total: fieldsInSection,
                        percentage: Math.round((filledInSection / fieldsInSection) * 100)
                    };
                    
                    totalFilled += filledInSection;
                    totalFields += fieldsInSection;
                });

                setSectionCompletion(sectionData);
                setCompletionPercentage(Math.round((totalFilled / totalFields) * 100));
            };

            // Format currency with commas and dollar sign
            const formatCurrency = (value) => {
                if (!value) return '';
                const number = value.toString().replace(/[^0-9]/g, '');
                if (!number) return '';
                return Number(number).toLocaleString('en-US');
            };

            const parseCurrency = (value) => {
                if (!value) return '';
                return value.toString().replace(/[^0-9]/g, '');
            };

            const handleCurrencyChange = (field, value) => {
                const numericValue = parseCurrency(value);
                setFormData(prev => ({ ...prev, [field]: numericValue }));
            };

            const handleInputChange = (field, value) => {
                setFormData(prev => ({ ...prev, [field]: value }));
            };

            const handleArrayChange = (arrayName, index, field, value) => {
                setFormData(prev => {
                    const newArray = [...prev[arrayName]];
                    newArray[index] = { ...newArray[index], [field]: value };
                    return { ...prev, [arrayName]: newArray };
                });
            };

            const addArrayItem = (arrayName, template) => {
                setFormData(prev => ({
                    ...prev,
                    [arrayName]: [...prev[arrayName], template]
                }));
            };

            const removeArrayItem = (arrayName, index) => {
                setFormData(prev => ({
                    ...prev,
                    [arrayName]: prev[arrayName].filter((_, i) => i !== index)
                }));
            };

            const clearForm = () => {
                if (window.confirm('Are you sure you want to clear all form data? This cannot be undone.')) {
                    localStorage.removeItem('captlg-form-data');
                    setFormData({
                        client1Name: '',
                        client1Birthday: '',
                        client2Name: '',
                        client2Birthday: '',
                        address: '',
                        city: '',
                        state: '',
                        zipCode: '',
                        grossIncome1: '',
                        grossIncome2: '',
                        medicalInsurance1: '',
                        medicalInsurance2: '',
                        preTaxRetirement1: '',
                        preTaxRetirement2: '',
                        postTaxInvestments1: '',
                        postTaxInvestments2: '',
                        expensesPlanned: '',
                        realEstate: [{ name: '', equity: '' }],
                        retirement401k: [{ name: '', balance: '' }],
                        afterTaxRetirement: [{ name: '', balance: '' }],
                        brokerageAccounts: [{ name: '', balance: '' }],
                        collegeSavings: [{ name: '', balance: '' }],
