                                                onClick={() => removeArrayItem('otherLiabilities', index)}
                                                style={{
                                                    padding: '8px 12px',
                                                    background: '#dc3545',
                                                    color: 'white',
                                                    border: 'none',
                                                    borderRadius: '6px',
                                                    cursor: 'pointer',
                                                    fontSize: '13px',
                                                    fontWeight: '600'
                                                }}
                                            >
                                                Remove
                                            </button>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>

                    </div>

                    {/* Goals Section */}
                    <div style={{
                        background: 'white',
                        borderRadius: '15px',
                        padding: '30px',
                        marginBottom: '20px',
                        boxShadow: '0 10px 30px rgba(0,0,0,0.2)'
                    }}>
                        <h2 style={{ 
                            margin: '0 0 20px 0',
                            fontSize: '24px',
                            color: 'white',
                            background: 'linear-gradient(135deg, #045174 0%, #056691 100%)',
                            padding: '20px',
                            borderRadius: '10px',
                            boxShadow: '0 4px 12px rgba(4,81,116,0.3)'
                        }}>
                            Goals
                        </h2>
                        
                        <div>
                            <label style={{ display: 'block', marginBottom: '5px', fontSize: '14px', fontWeight: '600' }}>
                                Short Term Goals (1-3 years)
                            </label>
                            <textarea
                                value={formData.shortTerm}
                                onChange={(e) => handleInputChange('shortTerm', e.target.value)}
                                placeholder="e.g., Remodeling, Care for Dad..."
                                style={{
                                    width: '100%',
                                    padding: '10px',
                                    borderRadius: '8px',
                                    border: '2px solid #e0e0e0',
                                    fontSize: '14px',
                                    minHeight: '80px',
                                    fontFamily: 'inherit',
                                    resize: 'vertical',
                                    boxSizing: 'border-box'
                                }}
                            />
                        </div>
                        
                        <div style={{ marginTop: '15px' }}>
                            <label style={{ display: 'block', marginBottom: '5px', fontSize: '14px', fontWeight: '600' }}>
                                Mid Term Goals (3-10 years)
                            </label>
                            <textarea
                                value={formData.midTerm}
                                onChange={(e) => handleInputChange('midTerm', e.target.value)}
                                placeholder="e.g., Financial Strategy for Assets..."
                                style={{
                                    width: '100%',
                                    padding: '10px',
                                    borderRadius: '8px',
                                    border: '2px solid #e0e0e0',
                                    fontSize: '14px',
                                    minHeight: '80px',
                                    fontFamily: 'inherit',
                                    resize: 'vertical',
                                    boxSizing: 'border-box'
                                }}
                            />
                        </div>
                        
                        <div style={{ marginTop: '15px' }}>
                            <label style={{ display: 'block', marginBottom: '5px', fontSize: '14px', fontWeight: '600' }}>
                                Long Term Goals (10+ years)
                            </label>
                            <textarea
                                value={formData.longTerm}
                                onChange={(e) => handleInputChange('longTerm', e.target.value)}
                                placeholder="e.g., Income in retirement..."
                                style={{
                                    width: '100%',
                                    padding: '10px',
                                    borderRadius: '8px',
                                    border: '2px solid #e0e0e0',
                                    fontSize: '14px',
                                    minHeight: '80px',
                                    fontFamily: 'inherit',
                                    resize: 'vertical',
                                    boxSizing: 'border-box'
                                }}
                            />
                        </div>
                    </div>

                        </div>
                    </div>
                </div>
            );
        };

        ReactDOM.render(<CAPTLGIntakeForm />, document.getElementById('root'));
    </script>
</body>
</html>
