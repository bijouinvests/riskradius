<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Local Fiduciary | Pairing You with the Right Advisor</title>
    
    <!-- Google Fonts for a clean, modern look -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Color Palette - Professional Blue Theme */
            --primary-blue: #0F172A;       /* Dark Navy - Trust/Corporate */
            --accent-blue: #3B82F6;        /* Bright Tech Blue - Action */
            --soft-blue: #EFF6FF;          /* Lightest blue - Backgrounds */
            --text-dark: #1E293B;          /* Almost black text */
            --text-gray: #475569;          /* Softer text for labels */
            --white: #ffffff;
            --radius: 8px;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--white);
            color: var(--text-dark);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* --- Layout Containers --- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* --- Header / Nav --- */
        header {
            padding: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-blue);
        }
        
        .logo span {
            color: var(--accent-blue);
        }

        /* --- Hero Section --- */
        .hero {
            display: flex;
            flex-wrap: wrap; /* Allows stacking on mobile */
            min-height: 85vh; /* Takes up most of the screen */
        }

        /* The Blue Left Side */
        .hero-visual {
            flex: 1;
            background-color: var(--primary-blue);
            color: var(--white);
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        /* Decorative background element */
        .hero-visual::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, rgba(15,23,42,0) 70%);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 500px;
        }

        .hero h1 {
            font-size: 2.8rem;
            line-height: 1.1;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .hero p {
            font-size: 1.1rem;
            color: #cbd5e1; /* Light gray for readability on blue */
            margin-bottom: 30px;
        }

        .risk-radius-badge {
            display: inline-block;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.9rem;
            margin-bottom: 15px;
            color: var(--accent-blue);
            font-weight: 600;
        }

        /* --- The White Right Side (Form) --- */
        .hero-form {
            flex: 1.2; /* Slightly wider on desktop */
            background-color: var(--white);
            padding: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-wrapper {
            width: 100%;
            max-width: 450px; /* Keeps form from getting too long */
        }

        .form-header h2 {
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 10px;
            text-align: center;
        }

        .form-header p {
            color: var(--text-gray);
            text-align: center;
            font-size: 0.95rem;
            margin-bottom: 30px;
        }

        /* --- Form Styling (User Friendly) --- */
        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        input, select {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0; /* Light gray border */
            border-radius: var(--radius);
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.2s ease;
            background-color: #fcfcfc;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--accent-blue);
            background-color: var(--white);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        /* Remove default select arrow styling */
        select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%
